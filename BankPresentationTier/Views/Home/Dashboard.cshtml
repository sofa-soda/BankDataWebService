@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<header>
    <h1>Welcome to Your Profile</h1>
</header>

<!-- User Profile Information -->
<section id="userProfile">
    <h2>User Profile</h2>
    <img id="profilePicture" src="" alt="Profile Picture" />
    <p>UserName: <span id="userName"></span></p>
    <p>FirstName: <span id="firstName"></span></p>
    <p>LastName: <span id="lastName"></span></p>
    <p>Email: <span id="email"></span></p>
    <p>Phone: <span id="phoneNo"></span></p>
    <p>Address: <span id="streetAddress"></span>, <span id="suburb"></span> <span id="postalCode"></span> <span id="state"></span> <span id="country"></span></p>
    <button id="editUserButton" onclick="showEditUser()">Edit Profile</button>
</section>

<!-- Edit User Profile -->
<section id="editUserSection" style="display: none;">
    <h2>Edit User Profile</h2>
    <form id="userForm" onsubmit="updateUser(event)">
        <div>
            <input type="text" id="firstNameI" placeholder="First Name" required />
            <input type="text" id="lastNameI" placeholder="Last Name" />
            <input type="text" id="emailI" placeholder="Email" required />
            <input type="text" id="passwordI" placeholder="Password" required />
        </div>
        <div>
            <input type="text" id="phoneNoI" placeholder="Phone Number" />
            <input type="text" id="streetAddressI" placeholder="Street Address" />
            <input type="text" id="suburbI" placeholder="Suburb" />
            <input type="text" id="stateI" placeholder="State" />
        </div>
        <div>
            <input type="number" id="postalCodeI" value=0 placeholder="Postal Code" />
            <input type="text" id="countryI" placeholder="Country" />
            <button type="submit">Update Profile</button>
        </div>
    </form>
    <button onclick="SwitchToProfile(); loadProfile()">Go Back</button>
</section>

<!-- Account Summary -->
<section id="accountSummary">
    <h2>Account Summary</h2>
    <div id="accountsList">
        <!-- Accounts will be listed here -->
    </div>
</section>

<!-- Account Transaction History -->
<section id="transactionHistory" style="display: none;">
    <h2>Account Transaction History</h2>
    <div id="transactionList">
        <!-- Transactions will be listed here -->
    </div>
    <button id="recentBtn" onclick="changeFilter()">Recent</button>
    <button onclick="goBackToSummary()">Back to Account Summary</button>
</section>

<!-- Transactions -->
<section id="accountTransferSection">
    <h2>Account Transfer</h2>
    <form id="transferForm" onsubmit="initiateTransfer(event)">
        <input id="accountNoTransferringT" placeholder="AccountNo" required />
        <div>
            <input type="text" id="recipientAccountT" placeholder="Recipient Account Number" required/>
            <input type="number" id="transferAmountT" placeholder="Amount" required />
        </div>
        <textarea id="transferDescriptionT" placeholder="Description" required></textarea>
        <button type="submit">Send</button>
    </form>
    <div id="transferError" style="color: red; display: none;">Invalid transfer details. Please try again.</div>
</section>

<section id="depositSection" style="display: none;">
    <h2>Deposit</h2>
    <form id="depositForm" onsubmit="initiateDeposit(event)">
        <input id="accountNoTransferringD" placeholder="AccountNo" required />
        <div>
            <input type="number" id="transferAmountD" placeholder="Amount" required />
        </div>
        <textarea id="transferDescriptionD" placeholder="Description" required></textarea>
        <button type="submit">Send</button>
    </form>
</section>

<section id="withdrawalSection" style="display: none;">
    <h2>Withdrawal</h2>
    <form id="withdrawalForm" onsubmit="initiateWithdrawal(event)">
        <input id="accountNoTransferringW" placeholder="AccountNo" required />
        <div>
            <input type="number" id="transferAmountW" placeholder="Amount" required />
        </div>
        <textarea id="transferDescriptionW" placeholder="Description" required></textarea>
        <button type="submit">Send</button>
    </form>
</section>
<button onclick="showAccountTransfer()">Account Transfer</button>
<button onclick="showDeposit()">Deposit</button>
<button onclick="showWithdrawal()">Withdrawal</button>



@section Scripts {
    
    <script>
        

        let recentTransactions = true;
        let AccountNumber = 0;
        let user;
        

        document.addEventListener('DOMContentLoaded', async function() {
            const cookie = getCookie("user")
            console.log(cookie);
            cookie == null && (window.location.href = "/home");

            const username = cookie;
            user = await getUser(username);
            console.log(user);
            loadProfile();
            loadAccountSummary();
        });

        async function getUser(username) {
            const response = await fetch(`https://localhost:7151/api/Users/username/${encodeURIComponent(username)}`);
            if (response.ok) {
                user = await response.json();
                return user;
            } else {
                window.location.href = "/home";
            }

        }

        function loadProfile() {
            document.getElementById('userName').textContent = user.userName;
            document.getElementById('firstName').textContent = user.firstName;
            document.getElementById('email').textContent = user.email;

            user.profilePicture != null && (document.getElementById('profilePicture').src = user.profilePicture);
            user.lastName != null && (document.getElementById('lastName').textContent = user.lastName);
            user.phoneNo != null && (document.getElementById('phoneNo').textContent = user.phoneNo);
            user.streetAddress != null && user.streetAddress != "" && (document.getElementById('streetAddress').textContent = user.streetAddress);
            user.suburb != null && user.suburb != "" && (document.getElementById('suburb').textContent = user.suburb);
            user.state != null && user.state != "" && (document.getElementById('state').textContent = user.state);
            user.postalCode != null && user.postalCode != "" && (document.getElementById('postalCode').textContent = user.postalCode);
            user.country != null && user.country != "" && (document.getElementById('country').textContent = user.country);
        }

        function showEditUser() {
            $('#firstNameI').val(user.firstName);
            $('#lastNameI').val(user.lastName);
            $('#emailI').val(user.email);
            $('#passwordI').val(user.password);
            $('#phoneNoI').val(user.phoneNo);
            $('#streetAddressI').val(user.streetAddress);
            $('#suburbI').val(user.suburb);
            $('#stateI').val(user.state);
            $('#postalCodeI').val(user.postalCode);
            $('#countryI').val(user.country);

            document.getElementById('userProfile').style.display = 'none';
            document.getElementById('editUserSection').style.display = 'block';
        }

        function SwitchToProfile() {
            document.getElementById('userProfile').style.display = 'block';
            document.getElementById('editUserSection').style.display = 'none';
        }

        async function updateUser() {
            event.preventDefault()
            user.firstName = $('#firstNameI').val();
            user.lastName = $('#lastNameI').val();
            user.email = $('#emailI').val();
            user.password = $('#passwordI').val();
            user.phoneNo = $('#phoneNoI').val();
            user.streetAddress = $('#streetAddressI').val();
            user.suburb = $('#suburbI').val();
            user.state = $('#stateI').val();
            user.postalCode = ($('#postalCodeI').val() == "") ? null : $('#postalCodeI').val();
            user.country = $('#countryI').val();


            console.log(user);
            try {
                console.log(`https://localhost:7151/api/Users/${user.userName}`);
                const response = await fetch(`https://localhost:7151/api/Users/${user.userName}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(user)
                });

                if (response.ok) {
                    alert('User update was successful');
                } else {
                    alert('User update failed');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function loadAccountSummary() {
            console.log(`https://localhost:7151/api/Accounts/username/${encodeURIComponent(user.userName)}`)
            const response = await fetch(`https://localhost:7151/api/Accounts/username/${encodeURIComponent(user.userName)}`);
            if (response.ok)
            {
                const accounts = await response.json();
                console.log(accounts);
                const accountsList = document.getElementById('accountsList');

                accounts.forEach(account => {
                    const accountDiv = document.createElement('div');
                    accountDiv.innerHTML = `
                    <p>Account Number: ${account.accountNo}</p>
                    <p>Balance: $${account.balance}</p>
                    <button onclick="viewTransactionHistory('${account.accountNo}')">View Transactions</button>
                `;
                accountsList.appendChild(accountDiv);
                });
            }
            else {
                console.log('response didnt work');
            }
        }

        async function changeFilter() {
            const toggleBtn = document.getElementById('recentBtn');
            if (recentTransactions) {
                recentTransactions = false;
                toggleBtn.textContent = 'Old'
            } else {
                recentTransactions = true;
                toggleBtn.textContent = 'Recent'
            }
            const response = await fetch(`https://localhost:7151/api/Transactions/account/${encodeURIComponent(AccountNumber)}`);
            const transactions = await response.json();

            const filteredTransactions = filterTransactionsByDate(transactions);
            const transactionList = document.getElementById('transactionList');
            transactionList.innerHTML = ''; // Clear any existing transactions
            filteredTransactions.forEach(transaction => {
                const transactionDiv = document.createElement('div');
                transactionDiv.innerHTML = `
                    <p>Date: ${transaction.timeStamp}</p>
                    <p>Amount: $${transaction.amount}</p>
                `;
                transactionList.appendChild(transactionDiv);
            });
        }

        function filterTransactionsByDate(transactions) {
            console.log(recentTransactions);
            if (recentTransactions) {
                transactions.sort((a, b) => new Date(b.timeStamp) - new Date(a.timeStamp)); // Descending order (most recent first)
            } else {
                transactions.sort((a, b) => new Date(a.timeStamp) - new Date(b.timeStamp)); // Ascending order (oldest first)
            }
            return transactions;
        }


        async function viewTransactionHistory(accountNumber) {
            AccountNumber = accountNumber;
            console.log(`https://localhost:7151/api/Transactions/${encodeURIComponent(accountNumber)}`);
            const response = await fetch(`https://localhost:7151/api/Transactions/account/${encodeURIComponent(accountNumber)}`);
            const transactions = await response.json();

            const filteredTransactions = filterTransactionsByDate(transactions);
            const transactionList = document.getElementById('transactionList');
            transactionList.innerHTML = ''; // Clear any existing transactions
            filteredTransactions.forEach(transaction => {
                const transactionDiv = document.createElement('div');
                transactionDiv.innerHTML = `
                    <p>Date: ${transaction.timeStamp}</p>
                    <p>Amount: $${transaction.amount}</p>
                `;
                transactionList.appendChild(transactionDiv);
            });

            // Show transaction history and hide account summary
            document.getElementById('accountSummary').style.display = 'none';
            document.getElementById('transactionHistory').style.display = 'block';
        }

        function goBackToSummary() {
             document.getElementById('accountSummary').style.display = 'block';
             document.getElementById('transactionHistory').style.display = 'none';
        }

        function showAccountTransfer() {
            document.getElementById('accountTransferSection').style.display = 'block';
            document.getElementById('depositSection').style.display = 'none';
            document.getElementById('withdrawalSection').style.display = 'none';
        }

        function showDeposit() {
            document.getElementById('accountTransferSection').style.display = 'none';
            document.getElementById('depositSection').style.display = 'block';
            document.getElementById('withdrawalSection').style.display = 'none';
        }

        function showWithdrawal() {
            document.getElementById('accountTransferSection').style.display = 'none';
            document.getElementById('depositSection').style.display = 'none';
            document.getElementById('withdrawalSection').style.display = 'block';
        }

        async function initiateTransfer(event) {
            const recipientAccount = $('#recipientAccountT').val();
            const transferAmount = parseFloat($('#transferAmountT').val());
            const transferDescription = $('#transferDescriptionT').val();
            const accountNoTransferring = $('#accountNoTransferringT').val();

            if (isNaN(transferAmount) || transferAmount <= 0 || recipientAccount == accountNoTransferring) {
                document.getElementById('transferError').style.display = 'block';
                return;
            }

            const transferData = {
                "userName": user.userName,
                "amount": transferAmount,
                "description": transferDescription,
                "accountNo": accountNoTransferring,
                "targetAccountNo": recipientAccount
            }

            console.log(transferData);


            await fetch(`https://localhost:7151/api/Transactions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(transferData)
            }).then(response => {
                if (response.ok) {
                    alert('Transfer successful');
                }
            }).catch(error => {
                alert('Error: ' + error.message);
            });
        }

        async function initiateDeposit(event) {
            event.preventDefault();

            const transferAmount = parseFloat($('#transferAmountD').val());
            const transferDescription = $('#transferDescriptionD').val();
            const accountNoTransferring = $('#accountNoTransferringD').val();

            if (isNaN(transferAmount) || transferAmount <= 0 ) {
                document.getElementById('transferError').style.display = 'block';
                return;
            }

            const transferData = {
                "userName": user.userName,
                "amount": transferAmount,
                "description": transferDescription,
                "accountNo": accountNoTransferring
            }

            console.log(transferData);


            await fetch(`https://localhost:7151/api/Transactions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(transferData)
            }).then(response => {
                if (response.ok) {
                    alert('Transfer successful');
                }
            }).catch(error => {
                alert('Error: ' + error.message);
            });

        }

        async function initiateWithdrawal(event) {
            event.preventDefault();

            let transferAmount = parseFloat($('#transferAmountW').val());
            const transferDescription = $('#transferDescriptionW').val();
            const accountNoTransferring = $('#accountNoTransferringW').val();

            if (isNaN(transferAmount) || transferAmount <= 0 ) {
                document.getElementById('transferError').style.display = 'block';
                return;
            }
            transferAmount = transferAmount * -1;

            const transferData = {
                "userName": user.userName,
                "amount": transferAmount,
                "description": transferDescription,
                "accountNo": accountNoTransferring
            }

            console.log(transferData);


            await fetch(`https://localhost:7151/api/Transactions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(transferData)
            }).then(response => {
                if (response.ok) {
                    alert('Transfer successful');
                }
            }).catch(error => {
                alert('Error: ' + error.message);
            });
        }

    </script>
}