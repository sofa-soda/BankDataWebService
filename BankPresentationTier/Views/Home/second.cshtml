@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<header>
    <h1>Welcome to Your Profile</h1>
    <button id="logoutButton">Log Out</button>
</header>

<!-- User Profile Information -->
<section id="userProfile">
    <h2>User Profile</h2>
    <img id="profilePicture" src="" alt="Profile Picture" />
    <p>Name: <span id="userName"></span></p>
    <p>Email: <span id="userEmail"></span></p>
    <p>Phone: <span id="userPhone"></span></p>
    <button onclick="editProfile()">Edit Profile</button>
</section>

<!-- Account Summary -->
<section id="accountSummary">
    <h2>Account Summary</h2>
    <div id="accountsList">
        <!-- Accounts will be listed here -->
    </div>
    <button onclick="viewTransactionHistory()">View Transaction History</button>
</section>

<!-- Transaction History -->
<section id="transactionHistory" style="display: none;">
    <h2>Transaction History</h2>
    <div id="transactionList">
        <!-- Transactions will be listed here -->
    </div>
    <button onclick="goBackToSummary()">Back to Account Summary</button>
</section>

<!-- Money Transfer -->
<section id="moneyTransfer">
    <h2>Money Transfer</h2>
    <form id="transferForm" onsubmit="initiateTransfer(event)">
		<input type="text" id="recipientAccount" placeholder="Recipient Account Number" required /><a href="d:\01-dc\assignment02a\bankdatawebservice\bankpresentationtier\views\home\second.cshtml">d:\01-dc\assignment02a\bankdatawebservice\bankpresentationtier\views\home\second.cshtml</a>
        <input type="number" id="transferAmount" placeholder="Amount" required />
        <textarea id="transferDescription" placeholder="Description" required></textarea>
        <button type="submit">Transfer Money</button>
    </form>
    <div id="transferError" style="color: red; display: none;">Invalid transfer details. Please try again.</div>
</section>

<!-- Security Features -->
<section id="security">
    <button onclick="logout()">Log Out</button>
</section>

