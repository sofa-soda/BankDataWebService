@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<header>
    <h1>Welcome Admin</h1>
</header>

<button onclick="Logout()">Logout</button>

<div>
    <button onclick="showUserProfile()">Profile</button>
    <button onclick="showUserManagement()">User Management</button>
</div>

<!-- User Profile Information -->
<section id="userProfile">
    <h2>User Profile</h2>
    <img id="profilePicture" src="" alt="Profile Picture" />
    <p>UserName: <span id="userName"></span></p>
    <p>FirstName: <span id="firstName"></span></p>
    <p>LastName: <span id="lastName"></span></p>
    <p>Email: <span id="email"></span></p>
    <p>Phone: <span id="phoneNo"></span></p>
    <p>Address: <span id="streetAddress"></span>, <span id="suburb"></span> <span id="postalCode"></span> <span id="state"></span> <span id="country"></span></p>
    <button id="editUserButton" onclick="showEditUser()">Edit Profile</button>
</section>

<!-- Edit User Profile -->
<section id="editUserSection" style="display: none;">
    <h2>Edit User Profile</h2>
    <form id="userForm" onsubmit="updateUser(event)">
        <div>
            <input type="text" id="firstNameI" placeholder="First Name" required />
            <input type="text" id="lastNameI" placeholder="Last Name" />
            <input type="text" id="emailI" placeholder="Email" required />
            <input type="text" id="passwordI" placeholder="Password" required />
        </div>
        <div>
            <input type="text" id="phoneNoI" placeholder="Phone Number" />
            <input type="text" id="streetAddressI" placeholder="Street Address" />
            <input type="text" id="suburbI" placeholder="Suburb" />
            <input type="text" id="stateI" placeholder="State" />
        </div>
        <div>
            <input type="number" id="postalCodeI" value=0 placeholder="Postal Code" />
            <input type="text" id="countryI" placeholder="Country" />
            <button type="submit">Update Profile</button>
        </div>
    </form>
    <button onclick="SwitchToProfile(); loadProfile()">Go Back</button>
</section>

<!-- User Management -->
<section id="userManagementSection" style="display: none;">
    <h2>User Management</h2>
    <form id="searchByUserNameForm" onsubmit="SearchForUsers(event)">
        <input type="text" id="searchUsername" placeholder="UserName" required />
        <button type="submit">Search</button>
    </form>
    <div id="searchResults">
    </div>  
    <div id="editSearchUser"> 
    </div>
</section>

<section id="transactionManagementSection" style="display: none;">
    <h2>Transaction Management</h2>
    <form id="searchForTransactionForm" onsubmit="SearchForTransactions(event)">
        <input type="text" id="TsearchUserName" placeholder="UserName" required />
        <button type="submit">Search</button>
    </form>
    <div id="transactionSearchResults">

    </div>
</section>


@section Scripts {
    
    <script>
        let recentTransactions = true;
        let AccountNumber = 0;
        let user;
        

        document.addEventListener('DOMContentLoaded', async function() {
            const cookie = getCookie("user")
            console.log(cookie);
            cookie == null && (window.location.href = "/home/admin");

            const username = cookie;
            user = await getAdmin(username);
            console.log(user);
            loadProfile();
        });

        function Logout() {
            deleteCookie("user")
            window.location.href = "/home/admin";
        }

        async function getAdmin(username) {
            const response = await fetch(`https://localhost:7151/api/Users/username/${encodeURIComponent(username)}`);
            if (response.ok) {
                user = await response.json();
                return user;
            } else {
                window.location.href = "/home/admin";
            }
        }

        async function getUser(username) {
            const response = await fetch(`https://localhost:7151/api/Users/username/${encodeURIComponent(username)}`);
            if (response.ok) {
                user = await response.json();
                return user;
            }
        }


        function loadProfile() {
            document.getElementById('userName').textContent = user.userName;
            document.getElementById('firstName').textContent = user.firstName;
            document.getElementById('email').textContent = user.email;

            user.profilePicture != null && (document.getElementById('profilePicture').src = user.profilePicture);
            user.lastName != null && (document.getElementById('lastName').textContent = user.lastName);
            user.phoneNo != null && (document.getElementById('phoneNo').textContent = user.phoneNo);
            user.streetAddress != null && user.streetAddress != "" && (document.getElementById('streetAddress').textContent = user.streetAddress);
            user.suburb != null && user.suburb != "" && (document.getElementById('suburb').textContent = user.suburb);
            user.state != null && user.state != "" && (document.getElementById('state').textContent = user.state);
            user.postalCode != null && user.postalCode != "" && (document.getElementById('postalCode').textContent = user.postalCode);
            user.country != null && user.country != "" && (document.getElementById('country').textContent = user.country);
        }

        function showEditUser() {
            $('#firstNameI').val(user.firstName);
            $('#lastNameI').val(user.lastName);
            $('#emailI').val(user.email);
            $('#passwordI').val(user.password);
            $('#phoneNoI').val(user.phoneNo);
            $('#streetAddressI').val(user.streetAddress);
            $('#suburbI').val(user.suburb);
            $('#stateI').val(user.state);
            $('#postalCodeI').val(user.postalCode);
            $('#countryI').val(user.country);

            document.getElementById('userProfile').style.display = 'none';
            document.getElementById('editUserSection').style.display = 'block';
        }

        function SwitchToProfile() {
            document.getElementById('userProfile').style.display = 'block';
            document.getElementById('editUserSection').style.display = 'none';
        }

        async function updateUser(event) {
            event.preventDefault()
            user.firstName = $('#firstNameI').val();
            user.lastName = $('#lastNameI').val();
            user.email = $('#emailI').val();
            user.password = $('#passwordI').val();
            user.phoneNo = $('#phoneNoI').val();
            user.streetAddress = $('#streetAddressI').val();
            user.suburb = $('#suburbI').val();
            user.state = $('#stateI').val();
            user.postalCode = ($('#postalCodeI').val() == "") ? null : $('#postalCodeI').val();
            user.country = $('#countryI').val();

            try {
                const response = await fetch(`https://localhost:7151/api/Users/${user.userName}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(user)
                });

                if (response.ok) {
                    alert('User update was successful');
                } else {
                    alert('User update failed');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        function showUserProfile() {
            $('#userProfile').show();
            $('#editUserSection').hide();
            $('#userManagementSection').hide();
        }

        function showUserManagement() {
            $('#userProfile').hide();
            $('#editUserSection').hide();
            $('#userManagementSection').show();
            ShowUsers()
        }

        async function ShowUsers() {
            const response = await fetch(`https://localhost:7151/api/Users`);
            if (response.ok) {
                userList = await response.json();
            } else {
                alert('no users could be found');
            }
            $('#searchResults').empty();
            userList.forEach(temp => {
                const userDiv = document.createElement('div');
                userDiv.innerHTML = `
                    <p>UserName: ${temp.userName}</p>
                    <button onclick="editUser('${temp.userName}')">Edit</button>
                    <button onclick="deleteUser('${temp.userName}')">Delete</button>
                `;
                $('#searchResults').append(userDiv);
            });
        }


        async function SearchForUsers(event) {
            event.preventDefault()
            var searchTerm = $('#searchUsername').val().trim();
            var searchUser;
            const response = await fetch(`https://localhost:7151/api/Users/username/${encodeURIComponent(searchTerm)}`);
            if (response.ok) {
                searchUser = await response.json();
            } else {
                alert('no users could be found');
                return;
            }
            $('#searchResults').empty();

            const userDiv = document.createElement('div');
            userDiv.innerHTML = `
                <p>UserName: ${searchUser.userName}</p>
                <button onclick="editUser('${searchUser.userName}')">Edit</button>
                <button onclick="deleteUser('${searchUser.userName}')">Delete</button>
            `;
            $('#searchResults').append(userDiv);
        }


        async function deleteUser(searchUser) {
            const response = await fetch(`https://localhost:7151/api/Users/username/${encodeURIComponent(searchUser)}`, {
                method: 'DELETE', 
            });
            if (response.ok) {
                ShowUsers();
            } 
            else {
                alert('delete was unsuccessful');
                return;
            }
        }

        function editUser(searchUserName) {
            const searchUser = getUser(searchUserName);

            $('#searchResults').hide();
            const userDiv = document.createElement('div');
            userDiv.innerHTML = `
            <form id="adminEditUserForm" onsubmit="updateSearchUser(event, '${searchUser.userName}')">
                <div>
                    <input type="text" id="firstNameS" placeholder="First Name" required />
                    <input type="text" id="lastNameS" placeholder="Last Name" />
                    <input type="text" id="emailS" placeholder="Email" required />
                    <input type="text" id="passwordS" placeholder="Password" required />
                </div>
                <div>
                    <input type="text" id="phoneNoS" placeholder="Phone Number" />
                    <input type="text" id="streetAddressS" placeholder="Street Address" />
                    <input type="text" id="suburbS" placeholder="Suburb" />
                    <input type="text" id="stateS" placeholder="State" />
                </div>
                <div>
                    <input type="number" id="postalCodeS" value=0 placeholder="Postal Code" />
                    <input type="text" id="countryS" placeholder="Country" />
                    <button type="submit">Update Profile</button>
                </div>
            </form>
            <button onclick="SwitchToSearchResults()">Go Back</button>
            `
            $('#editSearchUser').append(userDiv);
        }

        function SwitchToSearchResults() {
            $('#editSearchUser').hide();
            $('#searchResults').show();
        }

        async function updateSearchUser(event, searchUserName) {
            event.preventDefault()
            const searchUser = getUser(searchUserName);

            searchUser.firstName = $('#firstNameS').val();
            searchUser.lastName = $('#lastNameS').val();
            searchUser.email = $('#emailS').val();
            searchUser.password = $('#passwordS').val();
            searchUser.phoneNo = $('#phoneNoS').val();
            searchUser.streetAddress = $('#streetAddressS').val();
            searchUser.suburb = $('#suburbS').val();
            searchUser.state = $('#stateS').val();
            searchUser.postalCode = ($('#postalCodeS').val() == "") ? null : $('#postalCodeS').val();
            searchUser.country = $('#countryS').val();

            try {
                const response = await fetch(`https://localhost:7151/api/Users/${searchUser.userName}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(user)
                });

                if (response.ok) {
                    alert('User update was successful');
                } else {
                    alert('User update failed');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

    </script>
}