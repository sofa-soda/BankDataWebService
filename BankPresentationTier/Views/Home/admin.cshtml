@{
    ViewBag.Title = "Admin Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Admin Login</h2>

<div id="login-result" style="color: red;"></div>

<form id="login-form">
    <div>
        <label>Username:</label>
        <input type="text" id="username" required />
    </div>
    <div>
        <label>Password:</label>
        <input type="password" id="password" required />
    </div>
    <button type="submit">Login</button>
</form>

@section Scripts {
    
    <script>
        const cookie = getCookie("user")
        if (cookie != null) {
            window.location.href = "/home/admindashboard";
        }

        document.getElementById("login-form").addEventListener("submit", async function (e) {
            e.preventDefault();


            const resultDiv = document.getElementById("login-result");

            resultDiv.style.color = "black";
            resultDiv.textContent = "Logging in...";

            const userLogin = {
                "userName": $("#username").val().trim(),
                "password": $("#password").val().trim()
            }

            try {
                console.log('https://localhost:7151/api/Users/login');
                const response = await fetch('https://localhost:7151/api/Users/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(userLogin)
                });
                if (!response.ok) {
                    resultDiv.style.color = "red";
                    resultDiv.textContent = "Invalid username or password.";
                    return;
                }

                resultDiv.style.color = "green";
                resultDiv.textContent = "Login successful! Redirecting...";
                setCookie("user", userLogin.userName, 7);
                setTimeout(() => {
                        window.location.href = "/home/admindashboard";
                }, 1000);
            } catch (err) {
                console.error("Login error:", err);
                resultDiv.style.color = "red";
                resultDiv.textContent = "An error occurred during login.";
            }
        });
    </script>
}